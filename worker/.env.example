# ---------------------------------------------------------------------------
# Core worker / queue
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
QUEUE_NAME=jobs
CHANNEL_NAME=new_job

# dev | prod — dev enables debugpy (see WORKER_DEBUGPY docs)
MODE=dev

# DEBUG | INFO | WARNING | ERROR | CRITICAL — controls log verbosity only
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# OpenRouter (visual captioning / context task)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ---------------------------------------------------------------------------
# Supabase (Storage downloads + result writes)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AssemblyAI (audio transcription)
# ---------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# Roboflow (OWLv2 product/logo reference detection)
# ---------------------------------------------------------------------------
ROBOFLOW_API_KEY=
ROBOFLOW_OWLV2_URL=https://infer.roboflow.com/owlv2/infer

# ---------------------------------------------------------------------------
# Frame-sampling model weights
# ---------------------------------------------------------------------------
WARM_MODELS=true
EAST_MODEL_PATH=/app/assets/models/frozen_east_text_detection.pb
MOBILECLIP_MODEL_NAME=MobileCLIP2-S0
MOBILECLIP_PRETRAINED_TAG=dfndr2b