DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
QUEUE_NAME=jobs
CHANNEL_NAME=new_job
DEBUG=True

OPENROUTER_API_KEY=


SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=

ASSEMBLYAI_API_KEY=

# Optional hosted OCR; leave all four blank to disable paid inference.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE_ID=
ROBOFLOW_OCR_WORKFLOW_ID=
ROBOFLOW_OCR_TIMEOUT_SECONDS=

# Frame-sampling model weights Env vars
WARM_MODELS=true

EAST_MODEL_PATH=/app/assets/models/frozen_east_text_detection.pb
MOBILECLIP_WEIGHTS_PATH=/app/assets/models/mobileclip_s0.pt
MOBILECLIP_MODEL_NAME=MobileCLIP-S0
