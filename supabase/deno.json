{
  "tasks": {
    "test:unit": "deno test --allow-env tests/functions/unit",
    "test:integration": "deno test --allow-env --allow-net tests/functions/integration",
    "eval": "deno run --allow-env --allow-net --allow-read --env-file=functions/.env tests/eval/run_golden.ts"
  },
  "fmt": {
    "include": ["functions", "tests"]
  },
  "lint": {
    "include": ["functions", "tests/functions"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@0.224.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.39.8",
    "zod": "npm:zod@^3.25.76"
  }
}
